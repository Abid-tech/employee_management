# Copy to backend/.env for local work, or set these in the hosting dashboard.

# MongoDB Atlas connection string
MONGODB_URI=

# Signs the login token. Any long random string.
JWT_SECRET=

# Optional. Without a key the document import falls back to a built-in reader.
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Local port. Not used on Vercel, which routes to api/index.js.
PORT=9505
