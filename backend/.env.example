# Copy to .env and fill in. Never commit the real .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/employee_management?appName=Cluster0

# Optional. Without it the document import falls back to a built-in reader.
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=4000
