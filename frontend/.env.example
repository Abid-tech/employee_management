# Copy to frontend/.env for local work, or set these in the hosting dashboard.

# Where the API lives. Leave EMPTY in development: calls stay relative and the
# Vite proxy forwards them. In production set it to the deployed API origin,
# e.g. https://your-api.vercel.app  (no trailing slash).
VITE_API_URL=

# Attendance map
VITE_OFFICE_LATITUDE=
VITE_OFFICE_LONGITUDE=
VITE_ATTENDANCE_RADIUS=50
VITE_GOOGLE_MAPS_API_KEY=
